<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PcWatch - a pinnable desktop CPU monitor.
    2026-08-31. Ported from the PowerShell tray tool in the parent folder, which could not be pinned:
    Windows offers "Pin to taskbar" only for shortcuts to executables, never for .vbs or .ps1.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!--
      2026-09-02. Target framework is a PROPERTY so the app builds against either runtime.
      Default is net11.0-windows; .NET 10 works too and loses only the VisualStylesMode opt-in.
      Build commands are in the README: an XML comment cannot contain a double hyphen, so the
      flags cannot be written here without breaking the project file.
    -->
    <PcWatchTfm Condition="'$(PcWatchTfm)' == ''">net11.0-windows</PcWatchTfm>
    <TargetFramework>$(PcWatchTfm)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PcWatch</RootNamespace>
    <AssemblyName>PcWatch</AssemblyName>
    <ApplicationIcon>PcWatch.ico</ApplicationIcon>

    <!-- Per-monitor DPI: the process table is fixed-width, and a blurry bitmap-scaled window
         makes the columns unreadable on a high-DPI display. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <Version>1.1.0</Version>
    <Product>PC Watch</Product>
    <AssemblyTitle>PC Watch</AssemblyTitle>
    <Description>Real CPU load, and what is causing it.</Description>

    <!-- Required by the LibraryImport source generator, which emits unsafe marshalling stubs.
         Not a licence for unsafe application code: there is none, and TreatWarningsAsErrors keeps
         the surface honest. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      PRIVACY: do not ship the builder's home directory inside the binary.

      2026-09-02. The published exe carried the full intermediate-output path of its own PDB in the
      debug directory, starting from the builder's home folder. Every downloader of a release
      therefore learned the builder's Windows username. Nothing warns about this; it is simply what
      the compiler writes by default.

      DebugType=embedded removes the external PDB reference (and therefore that path) while keeping
      line numbers in stack traces. PathMap rewrites the remaining compile-time source paths to a
      neutral /src/ root. ContinuousIntegrationBuild makes the output deterministic, so two people
      building the same commit get byte-identical binaries and a release can be verified.

      Proven by app/check-no-leaks.ps1, which scans the built binary and fails on a match.
    -->
    <!--
      ⛔ 2026-09-04: THE PRIVACY HARDENING SILENTLY DISABLES COVERAGE MEASUREMENT.

      PathMap rewrites source paths to /src/, and a coverage collector looks for those source files
      on disk to map instrumented lines back to code. It finds nothing, so it skips the whole module
      and reports an EMPTY result - not an error, not a warning, just zero files and a 0% score that
      looks like a configuration mistake rather than what it is.

      CoverageBuild turns the three privacy/determinism settings off for a coverage run ONLY. A
      release build never sets it, so shipped binaries keep every protection, and check-no-leaks.ps1
      remains the backstop that would catch a release accidentally built this way.
    -->
    <CoverageBuild Condition="'$(CoverageBuild)' == ''">false</CoverageBuild>
    <DebugType Condition="'$(CoverageBuild)' != 'true'">embedded</DebugType>
    <DebugType Condition="'$(CoverageBuild)' == 'true'">portable</DebugType>
    <PathMap Condition="'$(CoverageBuild)' != 'true'">$(MSBuildThisFileDirectory)=/src/</PathMap>
    <ContinuousIntegrationBuild Condition="'$(CoverageBuild)' != 'true'">true</ContinuousIntegrationBuild>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- 2026-09-02: SELF-CONTAINED now that the app targets .NET 11 preview. There is no system-wide
         .NET 11 runtime (installing one needs admin), so a framework-dependent build only runs with
         DOTNET_ROOT pointing at the private SDK - fine from a shell, useless for a pinned taskbar
         button or for anyone downloading a release. Costs disk, buys an app that just runs. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- No PackageReference for System.Diagnostics.EventLog: NU1510 pointed out it already ships in
       the net10.0-windows framework, so adding it was redundant. SystemUptime.cs uses it to read
       the System log, which is the only way to learn when the machine actually came up. -->

  <ItemGroup>
    <!-- Kept beside the exe as well as embedded. ApplicationIcon gives Explorer and the taskbar
         their icon; the Form loads this file so Alt-Tab and the title bar get the crisp 16/24/32 px
         images rather than a rescaled 256. -->
    <None Update="PcWatch.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
